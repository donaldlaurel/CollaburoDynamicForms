DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_VERIFICATION_FROM="Collaburo <onboarding@resend.dev>"
EMAIL_VERIFICATION_SECRET="choose_a_long_random_secret"
EMAIL_VERIFICATION_TEST_MODE="false"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose_a_strong_password"
# Optional. Outside production the admin session cookie is also issued with
# SameSite=None so login survives cross-site iframe previews. Set to "true" only
# if the DEPLOYED admin must stay logged in while embedded in another site.
ADMIN_ALLOW_EMBEDDED_SESSION="false"
